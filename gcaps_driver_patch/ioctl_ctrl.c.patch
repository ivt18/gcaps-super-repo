+/*
+ * GCAPS: RCU-safe pid -> rt_priority.
+ *
+ * The published patch called pid_task(find_vpid(...)) bare, and held the
+ * resulting task_struct * across the SLEEPING runlist reload.  Both are
+ * use-after-free hazards and splat under CONFIG_PROVE_RCU.  The lookups
+ * cannot be wrapped in one long rcu_read_lock() precisely because this ioctl
+ * sleeps, so each one copies out what it needs under a short read-side
+ * section instead.
+ *
+ * Returns GCAPS_NO_PRIO when the task has exited; every caller treats that as
+ * "not a real-time task", which is the conservative direction.
+ */
+#define GCAPS_NO_PRIO (-1)
+
+static int gcaps_rt_prio_of(pid_t pid)
+{
+	struct task_struct *t;
+	int prio = GCAPS_NO_PRIO;
+
+	rcu_read_lock();
+	t = pid_task(find_vpid(pid), PIDTYPE_PID);
+	if (t != NULL)
+		prio = (int)t->rt_priority;
+	rcu_read_unlock();
+
+	return prio;
+}
+
+/*
+ * GCAPS: is this tgid a desktop-compositor process that must never be evicted
+ * from the runlist?  Copies comm out under RCU rather than returning a
+ * borrowed task_struct *.
+ *
+ * task->comm is truncated to TASK_COMM_LEN-1 chars, so compare over that
+ * length.  On the R35 board (Ubuntu 20.04) mutter runs inside gnome-shell, so
+ * these two names are complete; GNOME 43+ splits out "mutter-x11-frames" and
+ * would need it added here.
+ */
+static bool gcaps_is_except_proc(pid_t tgid)
+{
+	static const char * const except[] = { "Xorg", "gnome-shell" };
+	struct task_struct *t;
+	char comm[TASK_COMM_LEN];
+	unsigned int k;
+
+	comm[0] = '\0';
+
+	rcu_read_lock();
+	t = pid_task(find_vpid(tgid), PIDTYPE_PID);
+	if (t != NULL)
+		strscpy(comm, t->comm, sizeof(comm));
+	rcu_read_unlock();
+
+	if (comm[0] == '\0')
+		return false;
+
+	for (k = 0; k < ARRAY_SIZE(except); k++) {
+		if (strncmp(except[k], comm, TASK_COMM_LEN - 1) == 0)
+			return true;
+	}
+	return false;
+}
+
+/**
+ * Description: get the task and its tsgs with the highest priority from pending tsgs
+ * 
+ * @param #pid_h: [out]
+ * @param #tsg_bitmap: [out] the bitmap of tsgs of proc #pid_h
+ */
+void nvgpu_get_tsgs_with_highest_prio_locked(struct gk20a *g, 
+											pid_t *pid_next,
+											int *rt_prio_next,
+											unsigned long *tsgs_next) {
+	struct nvgpu_fifo *f = &g->fifo;
+	struct nvgpu_sched_ctrl *sched = &g->sched_ctrl;
+	struct nvgpu_tsg *tsg;
+	int prio_highest = 0;
+	int i = 0;
+
+	*pid_next = -1;
+	*tsgs_next = 0;
+	*rt_prio_next = 0;
+
+	for (i = 0; i < f->num_channels; i++) {
+		tsg = &f->tsg[i];
+		if (!NVGPU_SCHED_ISSET(tsg->tsgid, sched->active_tsg_bitmap)) {
+			continue;
+		}
+		/* tsg in pending list */
+		if (nvgpu_test_bit(i, sched->rl_ctrl.tsg_pending)) {
+			int prio = gcaps_rt_prio_of(tsg->tgid);
+
+			if (prio >= 1 && prio <= 99 && prio > prio_highest) {
+				prio_highest = prio;
+				*pid_next = tsg->tgid;
+			}
+		}	
+	}
+
+	if (*pid_next == -1) {
+		return;
+	}
+
+	*rt_prio_next = gcaps_rt_prio_of(*pid_next);
+	if (*rt_prio_next < 0) {
+		/* winner exited between the scan and here: report "none" */
+		*pid_next = -1;
+		*rt_prio_next = 0;
+		return;
+	}
+
+	for (i = 0; i < f->num_channels; i++) {
+		tsg = &f->tsg[i];
+		if (tsg->tgid == *pid_next) {
+			nvgpu_set_bit(i, tsgs_next);
+		}
+	}
+}
+
+/** 
+ * Description: TSGs management in the runlist
+ * 
+ * *****************************************
+ * #op_type stands for regular GPU segments.
+ * 
+ * Steps:
+ * - If the caller task requests to be added to the runlists with #op_type:
+ * 		- If the caller task is not a rt task, then check #pid_rt_kernel and #pid_rt_memcpy
+ * 			- if there is no rt task in runlists of the same #op_type as caller requested, add caller task to the runlist
+ * 			- otherwise, remove the caller
+ * 		- If the caller task is a rt task, then check #pid_rt_kernel and #pid_rt_memcpy
+ * 			- if the prio of the caller task is higher than the current prio, add the caller task to the runlist and remove the other tasks with same #op_type
+ * 			- if the prio of the caller task is not higher than the current prio (with the same #op_type), remove the caller task from runlists
+ * - If the caller task requests to be removed from the runlists with #op_type:
+ * 		- find the highest rt task in #tsg_pending_kernel or #tsg_pending_memcpy (of the same #op_type)
+ * 			- if not exist, resume all tasks in #tsg_pending_kernel or #tsg_pending_memcpy
+ * 			- if exist, add this task to runlists
+ */
+int nvgpu_ioctl_runlist_update_rt_prio(struct gk20a *g, 
+		struct nvgpu_gpu_runlist_update_rt_prio_args *args) 
+{
+	struct nvgpu_fifo *f = &g->fifo;
+	struct nvgpu_sched_ctrl *sched = &g->sched_ctrl;
+	struct nvgpu_rl_ctrl *rl_ctrl = &sched->rl_ctrl;
+	struct nvgpu_rt_rl *rt_task_in_rl = &rl_ctrl->rt_task_in_rl;
+	/* NOT a task_struct *: this outlives the sleeping runlist reload. */
+	int caller_prio;
+	int i;
+	int err = 0;
+	pid_t cpid = args->pid;
+	bool add_req = args->add_req;
+	bool sync_mode = args->sync_mode;
+	/* the complete bitmap of TSGs to be in the runlists. "set" to be added, "clear" to be removed */
+	unsigned long *new_tsg_in_rl = nvgpu_kzalloc(g, sched->bitmap_size);
+	/* the bitmap of the tsgs of the caller task */
+	unsigned long *tsgs_cpid = nvgpu_kzalloc(g, sched->bitmap_size);
+	bool exist = false;
+	ktime_t start_time;
+	ktime_t stop_time;
+	s64 elapsed_time;
 
+	pid_t pid_next = -1;
+	int rt_prio_next = 0;
+	/* when the caller requests to be removed, the next tsgs with highest rt prio */
+	unsigned long *tsgs_next = nvgpu_kzalloc(g, sched->bitmap_size);
+
+	/* GCAPS measurement instrumentation (added): describe the state
+	 * transition this ioctl performed so userspace can attribute the
+	 * scheduling/preemption overhead and reconstruct suspend intervals. */
+	bool rl_updated = false;       /* did an actual runlist reload happen */
+	pid_t preempted_pid = -1;      /* rt task evicted to pending by this add */
+	pid_t resumed_pid = -1;        /* task put back into the runlist on remove */
+
+
+	*new_tsg_in_rl = 0;
+	*tsgs_cpid = 0;
+	*tsgs_next = 0;
+
+	caller_prio = gcaps_rt_prio_of(cpid);
+
+	/* sync-based approach, no need to update runlists */
+	if (sync_mode == true) {
+		if (add_req == true) {
+			nvgpu_mutex_acquire(&sched->sync_fence_lock);
+			nvgpu_kfree(g, tsgs_next);
+			nvgpu_kfree(g, tsgs_cpid);
+			nvgpu_kfree(g, new_tsg_in_rl);
+			return 0;
+		}else {
+			nvgpu_mutex_release(&sched->sync_fence_lock);
+			nvgpu_kfree(g, tsgs_next);
+			nvgpu_kfree(g, tsgs_cpid);
+			nvgpu_kfree(g, new_tsg_in_rl);
+			return 0;
+		}
+	}
+
+	rt_mutex_lock(&sched->cs_lock);
+	start_time = ktime_get();
+	/* get tsgs of the excepted proc */
+	for (i = 0; i < f->num_channels; i++) {
+		struct nvgpu_tsg *tsg = &f->tsg[i];
+		if (gcaps_is_except_proc(tsg->tgid)) {
+			nvgpu_set_bit(i, new_tsg_in_rl);
+		}
+	}
+
+	/* get tsgs of the caller task by pid */
+	for (i = 0; i < f->num_channels; i++) {
+		struct nvgpu_tsg *tsg = &f->tsg[i];
+		if (!NVGPU_SCHED_ISSET(tsg->tsgid, sched->active_tsg_bitmap)) {
+			continue;
+		}
+		if (tsg->tgid == cpid) {
+			nvgpu_set_bit(i, tsgs_cpid);
+		}
+	}
+
+	if (add_req) { /* the caller task requests to be added */
+		if (caller_prio <= 0) { /* not a rt task, or it has exited */
+			/* no rt task of the same #op_type, add the caller to runlists */
+			if (rt_task_in_rl->pid == RL_CTRL_NO_RT_PID) {
+				// pr_info("------ be task pid %d add request granted\n", cpid);
+				/* no rt task being scheduled in the runlists, add the caller to runlists */
+				*rl_ctrl->tsg_running |= *tsgs_cpid;
+				*rl_ctrl->tsg_pending &= ~(*tsgs_cpid);
+			}else { /* there is a rt task in runlists*/
+				/* nothing else should be removed from runlists, add caller to pending */
+				// pr_info("------ be task pid %d add request pending\n", cpid);
+				*rl_ctrl->tsg_pending |= *tsgs_cpid;
+				*rl_ctrl->tsg_running &= ~(*tsgs_cpid);
+			}
+			/* not need to update #rt_rl_kernel and #rt_rl_memcpy */
+		}else { /* the caller task is a rt task */
+			/* do not allow interleaved execution if tasks are of the same rt_prio, use FIFO in this case */
+			/* the caller's rt_prio is higher than the running one of the same #op_type, add it to the runlists, and REMOVE the current running ones (add to pending) */
+			if (caller_prio > rt_task_in_rl->rt_prio) {
+				/* the running rt task (if any) is about to be evicted to
+				 * pending by this higher-priority add: record the victim. */
+				preempted_pid = rt_task_in_rl->pid;
+				/* the caller's rt_prio is higher than the running one of the same #op_type, add it to the runlists, and REMOVE the current running ones (add to pending) */
+				// pr_info("------ rt task pid %d add request granted\n", cpid);
+					*rl_ctrl->tsg_pending |= *rl_ctrl->tsg_running;
+					*rl_ctrl->tsg_running = *tsgs_cpid;
+					*rl_ctrl->tsg_pending &= ~(*tsgs_cpid);
+					rt_task_in_rl->pid = cpid;
+					rt_task_in_rl->rt_prio = caller_prio;
+			}else {
+				/* the caller's rt_prio is not higher than the running one of the same #op_type, remove it from runlists */
+				// pr_info("------ rt task pid %d add request pending\n", cpid);
+				*rl_ctrl->tsg_pending |= *tsgs_cpid;
+				*rl_ctrl->tsg_running &= ~(*tsgs_cpid);
+			}
+		}
+	}else { /* the caller task requests to be removed */	
+		// todo: check pid_next logic
+		nvgpu_get_tsgs_with_highest_prio_locked(g, &pid_next, &rt_prio_next, tsgs_next);
+		if (pid_next > 0) {
+			// pr_info("rt task pid %d requested to be removed, pid_next %d\n", cpid, pid_next);
+			if (pid_next == cpid) { // case 1: the caller task is a rt task
+				// pr_alert("this must be reported: pid_next = tsgs_cpid");
+				*rl_ctrl->tsg_pending &= ~(*tsgs_next);
+				*rl_ctrl->tsg_running &= ~(*tsgs_next);
+				if (*rl_ctrl->tsg_running == 0) { // only be task left
+					rt_task_in_rl->pid = RL_CTRL_NO_RT_PID;
+					rt_task_in_rl->rt_prio = RL_CTRL_NO_RT_PRIO;
+				}
+			}else if ((*rl_ctrl->tsg_running & *tsgs_cpid) == 0) {
+				/* The caller has already been preempted: the preemptor is
+				 * still running and outranks every pending task, so this
+				 * segment-end changes nothing about who should be on the
+				 * runlist.  Drop only the caller's own bits.
+				 *
+				 * Falling through to the branch below would OVERWRITE
+				 * tsg_running with the next pending task, evicting the
+				 * running preemptor mid-kernel and deadlocking it on its
+				 * fence.  See preempted-caller-runlist-overwrite-bug.md */
+				*rl_ctrl->tsg_pending &= ~(*tsgs_cpid);
+			}else {
+				resumed_pid = pid_next; /* this task is resumed back into the runlist */
+				/* Found the next rt task of #op_type: remove the CALLER and
+				 * admit that task.  Set difference + union, never a wholesale
+				 * assignment -- the caller is not necessarily the only entry
+				 * in tsg_running. */
+				*rl_ctrl->tsg_running &= ~(*tsgs_cpid);
+				*rl_ctrl->tsg_pending &= ~(*tsgs_cpid);
+				*rl_ctrl->tsg_running |= *tsgs_next;
+				*rl_ctrl->tsg_pending &= ~(*tsgs_next);
+				rt_task_in_rl->pid = pid_next;
+				rt_task_in_rl->rt_prio = rt_prio_next;
+			}
+		}else { // no pending rt task 
+			// pr_info("task pid %d requested to be removed. No real-time task pending. Resuming all tasks. ", cpid);
+			*rl_ctrl->tsg_pending &= ~(*tsgs_cpid);
+			*rl_ctrl->tsg_running &= ~(*tsgs_cpid);
+			// search tsg_running for rt tasks
+			for (i = 0; i < f->num_channels; i++) {
+				struct nvgpu_tsg *tsg = &f->tsg[i];
+				int prio;
+
+				if (!NVGPU_SCHED_ISSET(tsg->tsgid, sched->active_tsg_bitmap)) {
+					continue;
+				}
+				if (nvgpu_test_bit(i, sched->rl_ctrl.tsg_running)) {
+					prio = gcaps_rt_prio_of(tsg->tgid);
+					if (prio >= 1 && prio <= 99) {
+						// pr_alert("this must be reported: a pending be task is requesting to be removed, running rt task: %d.", tsg->tgid);
+						rt_task_in_rl->pid = tsg->tgid;
+						rt_task_in_rl->rt_prio = prio;
+						exist = true;
+						break;
+					}
+				}	
+			}
+			if (exist == false) { // only be task left
+				/* no rt task of #op_type exists, resume all TSGs */
+				*rl_ctrl->tsg_running = *rl_ctrl->tsg_pending;
+				*rl_ctrl->tsg_pending = 0;
+				rt_task_in_rl->pid = RL_CTRL_NO_RT_PID;
+				rt_task_in_rl->rt_prio = RL_CTRL_NO_RT_PRIO;
+			}
+		}
+	}
+
+	if ((*rl_ctrl->tsg_running & *rl_ctrl->tsg_pending) != 0) {
+		pr_warn("running and pending tsgs are not exclusive!!!");
+	}
+	*new_tsg_in_rl |= (*rl_ctrl->tsg_running); // using OR because of the excpetion tasks
+
+	/* update runlist */
+	if (*new_tsg_in_rl != *rl_ctrl->curr_tsgs_in_rl) {
+		rl_updated = true; /* a real runlist reload (incl. any GPU preemption) */
+		for (i = 0; i < f->num_channels; i++) {
+			struct nvgpu_tsg *tsg = &f->tsg[i];
+			struct nvgpu_channel *ch;
+			bool add = nvgpu_test_bit(i, new_tsg_in_rl);
+
+			/* The other three loops in this function gate on active_tsg_bitmap;
+			 * this one did not, so it walked torn-down slots and handed a bare
+			 * channel / NULL tsg->runlist to runlist.update -> "Bare channel in
+			 * runlist update" and a NULL deref.  Reproduced as a kernel oops
+			 * under doubled channel churn (-S 0.5). */
+			if (!NVGPU_SCHED_ISSET(tsg->tsgid, sched->active_tsg_bitmap)) {
+				continue;
+			}
+			if (tsg->runlist == NULL) {
+				continue;
+			}
+
+			nvgpu_list_for_each_entry(ch, &tsg->ch_list,
+					nvgpu_channel, ch_entry) {
+				err = g->ops.runlist.update(g, tsg->runlist, ch, add, true); // runlist lock is inside of it
+				if (err < 0) {
+					nvgpu_err(g, "update_by_pid failed");
+					goto done;
+				}
+			}
+		}
+		*rl_ctrl->curr_tsgs_in_rl = *new_tsg_in_rl;
+	}
+
+done:
+	stop_time = ktime_get();
+	elapsed_time = ktime_to_ns(ktime_sub(stop_time, start_time)) / 1000; // us
+	pr_info("process %d elapsed time: %lld", cpid, elapsed_time);
+	/* GCAPS_EV: one structured record per ioctl for measure_preempt_overhead.py.
+	 *   ts          - ktime (ns), same clock base as userspace CLOCK_MONOTONIC
+	 *   prio        - caller SCHED_FIFO rt_priority (1..99), -1 if unknown
+	 *   add         - 1 = entering a GPU segment, 0 = leaving it
+	 *   rlupd       - 1 = an actual runlist reload happened (scheduling work +
+	 *                 any GPU-side preemption), 0 = bookkeeping only
+	 *   elapsed_us  - duration of the critical section (GCAPS epsilon)
+	 *   preempted   - pid evicted to pending by this add (a preemption), or -1
+	 *   resumed     - pid re-admitted to the runlist by this remove, or -1 */
+	pr_info("GCAPS_EV ts=%lld cpid=%d prio=%d add=%d rlupd=%d elapsed_us=%lld preempted=%d resumed=%d",
+		ktime_to_ns(stop_time), cpid,
+		caller_prio,
+		add_req ? 1 : 0, rl_updated ? 1 : 0, elapsed_time,
+		preempted_pid, resumed_pid);
+	rt_mutex_unlock(&sched->cs_lock);
+
+	/* The published patch never freed these on ANY path -- ~3 x bitmap_size
+	 * of kernel memory leaked per ioctl call. */
+	nvgpu_kfree(g, tsgs_next);
+	nvgpu_kfree(g, tsgs_cpid);
+	nvgpu_kfree(g, new_tsg_in_rl);
+	return err;
+}
